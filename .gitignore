# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.ruff_cache/
.uv-cache/
.coverage
.coverage.*
htmlcov/
.zcode/
.qoder/

# Virtual environments
.venv/

# Local configuration and IDE state
.env
.env.*
!.env.example
.idea/
.vscode/
.runtime-user/

# Node/Web build and test outputs
web*/node_modules/
web*/dist/
web*/.vite/
web*/.tmp/
web*/coverage/
web*/playwright-report/
web*/test-results/

# Runtime artifacts. Keep only the directory contract in Git.
profiles/draft/
profiles/candidate/
profiles/history/
artifacts/**
!artifacts/README.md
reports/
screenshots/
*.log
*.db
*.db-*
*.sqlite
*.sqlite-*

# Temporary files
*.tmp
*.bak
*.swp
Thumbs.db
.DS_Store

# pytest 临时目录：Windows 下必须用 --basetemp 绕开系统 temp 权限问题；
# 这些目录里会带上被复制进来的生成脚本，既不能进版本库也不能参与 lint。
.pytest-*/
