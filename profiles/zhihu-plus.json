{
  "target_app_id": "zhihu-plus",
  "display_name": "知乎++",
  "bundle_name": "com.github.zhuoyi233.zhplus",
  "main_ability": "EntryAbility",
  "installation_status": "device_installed_unverified",
  "device_selector": { "serial": "127.0.0.1:5555" },
  "launch_strategy": {
    "kind": "hdc_aa_start",
    "command": "aa start -b com.github.zhuoyi233.zhplus -a EntryAbility"
  },
  "reset_strategy": {
    "kind": "stop_then_start_only",
    "clear_app_data": false
  },
  "test_data_strategy": {
    "mode": "anonymous_read_only",
    "login": false,
    "write_operations": false,
    "fixed_keyword": "OpenHarmony"
  },
  "permission_and_popup_strategy": {
    "mode": "dismiss_non_destructive_prompts_only",
    "login_prompt": "blocked",
    "captcha_prompt": "blocked"
  },
  "stable_locator_inventory": [
    {
      "name": "搜索",
      "key": "p2_home_titlebar_search",
      "id": "p2_home_titlebar_search",
      "type": "Button",
      "locator_priority": 1
    },
    {
      "name": "首页信息流",
      "key": "p2_home_feed_list",
      "id": "p2_home_feed_list",
      "type": "List",
      "locator_priority": 1
    },
    {
      "name": "输入框",
      "key": "p2_search_input",
      "id": "p2_search_input",
      "type": "TextInput",
      "locator_priority": 1
    }
  ],
  "known_limitations": [
    "匿名只读流程，不处理登录、验证码、支付或写操作",
    "信息流内容和内容卡片 ID 是动态数据，只能保存在运行观测中",
    "默认演示依赖模拟器中已安装知乎++"
  ]
}
