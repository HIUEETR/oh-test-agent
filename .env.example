OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AGENT_MODEL=
AGENT_VISION_MODEL=
AGENT_PROVIDER=auto
# Only the DeepSeek official endpoint honours thinking.type=disabled; OpenAI-compatible
# self-hosted endpoints ignore it, so it cannot work around tool_choice conflicts.
AGENT_DISABLE_THINKING=false
HDC_PATH=C:\path\to\openharmony\toolchains\hdc.exe
HARMONY_DEVICE=127.0.0.1:5555
HARMONY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:15173,http://localhost:15173
RUNTIME_DIR=artifacts/runs
RUNTIME_HOME=.runtime-user
DATABASE_PATH=artifacts/agent.db
TARGET_PROFILE_PATH=profiles/zhihu-plus.json
PROFILES_DIR=profiles
AGENT_MAX_STEPS=20
AGENT_ACTION_TIMEOUT=30
AGENT_MODEL_TIMEOUT=90
AGENT_RETRY_LIMIT=2
UNCHANGED_SCREEN_LIMIT=2
VLM_MIN_CONFIDENCE=0.55

# DC Mode（直流模式）：单次模型调用超时（AGENT_MODEL_TIMEOUT）必须 <= 轮次总预算
DC_TURN_TIMEOUT=600
DC_PROGRESS_INTERVAL=1.5
DC_CHECKPOINT_INTERVAL=2.0
DC_CLOSE_TIMEOUT=8.0
# 单轮模型请求/工具调用预算。pydantic-ai 按「模型 HTTP 请求次数」计数，DC 每轮只调一个
# 工具，故 request_limit 约等于工具往返数；默认 120/200 明显高于模型超时与轮次预算，
# 正常由 DC_TURN_TIMEOUT 先终止。长时间多步任务可调大，模型很慢时请同步调大
# AGENT_MODEL_TIMEOUT / DC_TURN_TIMEOUT。
DC_MODEL_REQUEST_LIMIT=120
DC_MODEL_TOOL_CALLS_LIMIT=200
# 注入 prompt 的 UI 树摘要元素上限；页面元素多（底部弹窗/表单）时调大可避免表单被截断
DC_UI_TREE_TOP_K=200
# 展示用上下文窗口大小：只用于把单次请求 input_tokens 换算成占用百分比，不参与限额判断
DC_MODEL_CONTEXT_WINDOW=128000
